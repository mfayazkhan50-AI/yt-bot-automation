# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored, so it never gets committed. This example file is safe
# to commit and documents every variable the bot needs.
# ---------------------------------------------------------------------------

# --- AI comment generation (required) ---------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for comment generation. "openrouter/auto" picks automatically.
# Note: some auto-routed models are reasoning models and need a large token
# budget; the app already accounts for that.
LLM_MODEL=openrouter/auto

# --- YouTube Data API (required) --------------------------------------------
# Get a key at https://console.cloud.google.com -> Enable YouTube Data API v3
YOUTUBE_API_KEY=

# --- Dashboard login (required) ----------------------------------------------
# Basic auth for the dashboard. Use a long random password, not this placeholder.
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Optional residential proxy ----------------------------------------------
# Simplest: one URL with optional credentials.
#   PROXY_URL=http://user:pass@host:port
# A {session} placeholder in the username gets replaced with a sticky per-run
# token so the whole commenting batch uses one egress IP:
#   PROXY_URL=http://user-session-{session}:pass@host:port
# PROXY_SESSION_ID pins that token to a fixed value (otherwise it is random).
# The bot also accepts a proxy_url (global, per-business, or per-account) in
# config.json, which takes priority over PROXY_URL.
PROXY_URL=
PROXY_SESSION_ID=

# Legacy split form (still supported). Leave all four empty to post directly.
# Only used when PROXY_URL and config.json proxy settings are empty.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Optional browser override -----------------------------------------------
# The bot uses a REAL Google Chrome install, found automatically at:
#   Windows  C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux    /usr/bin/google-chrome
# Only set this if Chrome lives somewhere unusual.
# Do NOT point this at Playwright's ms-playwright Chromium: Google
# fingerprints that build and serves a reCAPTCHA on every login.
# Linux example: /opt/google/chrome/chrome
CHROMIUM_PATH=

# Playwright Chromium is intentionally NOT supported and there is no flag to
# enable it: Google fingerprints that build and serves a reCAPTCHA on every
# login, which is exactly what broke 2FA. Real Chrome is required.

# --- Optional remote debugging (CDP) -----------------------------------------
# Exposes Chrome DevTools Protocol on 127.0.0.1:<port> for live inspection.
# Empty = off. Example: 9222
CHROME_DEBUG_PORT=

# --- Optional headless toggle -------------------------------------------------
# 1 = headless (normal for a VPS), 0 = show the browser window (local debugging).
HEADLESS_MODE=1

# --- Manual 2FA (interactive login only) -------------------------------------
# Seconds login() waits for a human to finish a verification step in a visible
# browser window. Only used by manual_login() / save_session.py --headful.
MANUAL_2FA_TIMEOUT=300

# Where browser profiles and saved cookie jars live. Defaults to ./sessions.
SESSION_DIR=
