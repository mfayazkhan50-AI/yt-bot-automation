# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored, so it never gets committed. This example file is safe
# to commit and documents every variable the bot needs.
# ---------------------------------------------------------------------------

# --- AI comment generation (required) ---------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for comment generation. "openrouter/auto" picks automatically.
# Note: some auto-routed models are reasoning models and need a large token
# budget; the app already accounts for that.
LLM_MODEL=openrouter/auto

# --- YouTube Data API (required) --------------------------------------------
# Get a key at https://console.cloud.google.com -> Enable YouTube Data API v3
YOUTUBE_API_KEY=

# --- Dashboard login (required) ----------------------------------------------
# Basic auth for the dashboard. Use a long random password, not this placeholder.
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Optional residential proxy ----------------------------------------------
# Leave all four empty to post directly. All four are needed together.
# If the VPS IP gets blocked by Google, fill these in.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Optional browser override -----------------------------------------------
# Only needed if the bot cannot find Chromium automatically. Normally leave
# empty and the bot uses the Playwright Chromium it installs for itself.
# Linux example: /root/.cache/ms-playwright/chromium-1234/chrome-linux/chrome
CHROMIUM_PATH=

# --- Optional headless toggle -------------------------------------------------
# 1 = headless (normal for a VPS), 0 = show the browser window (local debugging).
HEADLESS_MODE=1
